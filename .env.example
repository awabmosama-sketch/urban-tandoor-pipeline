DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?ssl=require
EMBEDDING_PROVIDER=openai          # openai | gemini | fake
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
DATA_DIR=./data
APP_ENV=dev
CHUNK_SIZE=800
CHUNK_OVERLAP=120
