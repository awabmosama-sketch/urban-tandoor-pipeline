# MongoDB Atlas (free M0 tier works). Replace with your own cluster URI.
# Example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=urban_tandoor
MONGODB_TIMEOUT_MS=8000

# JSON is the canonical ingestion format (Excel/DOCX -> JSON -> MongoDB).
JSON_DIR=./data/json

EMBEDDING_PROVIDER=fake           # openai | gemini | fake
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
DATA_DIR=./data
APP_ENV=dev
CHUNK_SIZE=800
CHUNK_OVERLAP=120
ADMIN_TOKEN=change-me
ADMIN_JOB_MAX_HISTORY=100
